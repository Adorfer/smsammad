; Vorlage fuer config.ini. Kopieren nach config.ini, echte Werte eintragen,
; danach: chmod 600 config.ini (config.ini enthaelt Zugangsdaten und ist in
; .gitignore).
;
; Alle Text-Werte MUESSEN in Anfuehrungszeichen stehen ("..." oder '...',
; beides geht) -- damit Werte mit Leerzeichen (Gruppennamen, Passwoerter,
; Pfade, ...) einfach so uebernommen werden koennen, ohne dass man sich
; Gedanken um Escaping machen muss, und damit ein Inline-Kommentar hinter
; dem Wert eindeutig als solcher erkennbar ist (siehe unten). Ein
; unquotierter Text-Wert ist ein Config-Fehler, die App bricht dann mit
; klarer Fehlermeldung ab statt den Wert stillschweigend falsch zu lesen.
; Zahlen (z.B. max_sms_parts) und true/false (z.B. verify_tls) bleiben
; OHNE Anfuehrungszeichen.
;
; Inline-Kommentare HINTER einem Wert sind erlaubt, z.B.:
;   token = "abc123"  # mein API-Token
;   max_sms_parts = 3  # maximal drei SMS-Teile
; Ein '#' INNERHALB der Anfuehrungszeichen (z.B. Teil eines Passworts wie
; "gEh middle#eim") wird NICHT als Kommentaranfang missverstanden.

[notification]
; Fehlerbenachrichtigung per Mail bei unbehandelten Exceptions.
; Abschnitt komplett weglassen, um Fehlermails dauerhaft zu deaktivieren.
smtp_host = "mail.example.local"
smtp_port = 587
smtp_user = "smsammad@example.local"
smtp_password = "CHANGEME"
recipient = "ops@example.local"
; Schalter zum temporaeren Deaktivieren, ohne obige Werte zu loeschen/
; auskommentieren zu muessen. Bei --dry-run wird ohnehin unabhaengig
; von diesem Wert nie eine Mail verschickt.
enabled = true

[teltonika]
; Zugang zum SMS-Gateway des Routers ueber dessen cgi-bin-Schnittstelle
; (/cgi-bin/sms_send, sms_list, sms_read, sms_delete, sms_total) -- also
; ALLES rund um SMS-Versand und -Empfang.
;
; WICHTIG: username/password hier sind NICHT das Router-Admin-Login und
; auch kein Benutzerkonto aus System -> Administration -> Users, sondern
; ein eigenes, feature-spezifisches Login-Paar aus der SMS-Gateway-
; Konfiguration des Routers (RutOS 7.x: Services -> Mobile Utilities ->
; SMS Gateway -> Post/Get; Menuepfad je nach Firmware-Version leicht
; abweichend). Dort "Post/Get" aktivieren und Username/Passwort setzen.
;
; Deshalb braucht die Guthaben-Abfrage per USSD ein ZWEITES, davon
; unabhaengiges Konto (s. [balance] api_username/api_password): sie laeuft
; ueber die moderne RutOS-REST-API (/api/...), und dieses cgi-bin-Login
; existiert in der Benutzerverwaltung ueberhaupt nicht -- ein /api/login
; damit scheitert live reproduzierbar mit HTTP 401.
;
; IP oder Hostname des Routers, ohne Schema
host = "192.168.1.1"
username = "user1"
password = "user_pass"
; ISO-Regioncode fuer die Rufnummer-Normalisierung (phonenumbers), z.B. DE
default_country_code = "DE"
; RUT-Router laufen ueblicherweise nur per HTTPS mit selbstsigniertem
; Zertifikat (Port 80 meist zu). scheme = http nur falls das Geraet
; tatsaechlich Klartext-HTTP spricht.
scheme = "https"
; Zertifikatspruefung: bei selbstsigniertem Zertifikat auf false lassen,
; sonst schlaegt jede Anfrage mit einem TLS-Fehler fehl.
verify_tls = false
; Praefix fuer einen zweiten Parse-Versuch, wenn eine Absendernummer nicht
; als gueltige Rufnummer erkannt wird (z.B. Kurzrufnummern ohne Vorwahl).
; Leer lassen, um diesen Rekonstruktionsversuch zu deaktivieren -- dann wird
; direkt der rohe Absender-String als Kunden-Identifikator verwendet.
short_number_prefix = "0172"
; Praefix fuer Absender, die auch mit obigem Praefix nicht als gueltige
; Rufnummer erkannt werden -- Kurzwahlen wie "22543" (Netzbetreiber-
; Systemnachrichten) oder alphanumerische Absender-IDs wie "CALLYA". Wird
; beim Empfang vor den rohen Absender-String gesetzt (z.B. "Kurzwahl:22543"
; bzw. "Kurzwahl:CALLYA") und landet so lesbar in Zammads Telefonfeld
; (Buchstaben sind dort kein Problem); beim Versand wird der Praefix wieder
; entfernt und roh an den Absender gesendet -- ermoeglicht auch Antworten an
; Kurzwahlen/alphanumerische Absender. Leer lassen, um stattdessen den rohen
; Absender-String ohne Praefix zu speichern.
unresolved_sender_prefix = "Kurzwahl:"
; Automatischer Retry bei transienten Router-Ueberlastungs-Symptomen: der
; Router antwortet auf lesende Anfragen (sms_list/sms_total/...) manchmal
; mit HTTP 200 + Klartext-Body "ERROR"/"TIMEOUT" statt echten Daten, wenn
; er anderweitig CPU-beschaeftigt ist (z.B. eigener sehr langer Multipart-
; SMS-Versand, siehe README) -- live so beobachtet. Deckt auch langsamen
; TCP-Connect/Verbindungsabbruch zum Router ab. NUR fuer lesende Endpunkte
; -- sms_send (Versand) wird NIE automatisch wiederholt, siehe README.
; retry_max_attempts = 0 deaktiviert den Retry komplett.
retry_max_attempts = 3
retry_first_delay_seconds = 20
retry_delay_seconds = 180

[balance]
; Prepaid-Guthaben-Ueberwachung der SIM-Karte im Router (optional -- Sektion
; komplett weglassen, um dieses Feature zu deaktivieren). Der
; 'balance-check'-Subcommand fragt taeglich das Guthaben ab.
;
; method = "ussd" (Default): synchron per RutOS-REST-API (/api/...),
;   Ergebnis liegt sofort vor, i.d.R. kostenlos. Braucht einen EIGENEN
;   Router-Account mit Zugriff auf die Mobile/USSD-API -- der cgi-bin-
;   SMS-Account (s. [teltonika]) hat dort KEINE Berechtigung (live
;   verifiziert: 401/403). Account im Router-WebUI anlegen (System ->
;   Administration -> Users) und dort explizit Zugriff auf Network ->
;   Mobile geben.
; method = "sms": Abfrage-SMS an eine Kurzwahl, Antwort trifft asynchron
;   ein und wird vom naechsten sms-to-ticket-Lauf ausgewertet (erkannt am
;   Absender reply_sender).
;
; Ist die jeweils andere Methode ZUSAETZLICH vollstaendig konfiguriert,
; schaltet balance-check bei einem Fehler der Default-Methode (Zugriff
; verweigert oder Antwort nicht parsebar) fuer diesen Lauf automatisch auf
; die andere um. Ohne konfigurierte Fallback-Methode wird der Fehler ganz
; normal per Fehlermail gemeldet.
method = "ussd"

; -- method = "ussd" --
; USSD-Code fuer die Guthaben-Abfrage.
; "*106#" (Default) ist bei Vodafone der DIREKTE Guthaben-Kurzcode: die
; Antwort ist abgeschlossen (+CUSD-Feld <m> = 0), es bleibt KEINE
; USSD-Sitzung offen, und die Antwort enthaelt weder Menue noch Umlaute.
; "*100#" oeffnet dagegen das interaktive Menue und laesst die Sitzung
; offen (<m> = 1) -- eine kurz darauf folgende Abfrage wird dann als
; MENUE-EINGABE in diese laufende Sitzung interpretiert und liefert
; "Ungueltige Eingabe" statt eines Guthabens (live beobachtet). Im
; taeglichen Cron-Betrieb faellt das nicht auf (Sitzungen laufen nach
; Minuten ab), bei manuellen Aufrufen kurz hintereinander schon.
ussd_code = "*106#"
; Zugangsdaten des dedizierten Mobile-API-Accounts (siehe oben): ein
; echtes Router-Benutzerkonto aus System -> Administration -> Users, mit
; explizit gesetztem Zugriff auf Network -> Mobile.
;
; Zum Namen "api_": beide Wege sind streng genommen APIs -- gemeint ist
; hier die moderne RutOS-REST-API (/api/..., JSON, Bearer-Token-Login),
; im Unterschied zum alten cgi-bin-SMS-Gateway aus [teltonika]
; (Klartext-Antworten, Credentials als Query-Parameter). USSD gibt es
; ausschliesslich auf der REST-API, SMS ausschliesslich auf cgi-bin --
; daher die zwei getrennten Zugaenge.
api_username = "smsammad"
api_password = "CHANGEME"
; Modem-ID wie in der Router-WebUI-URL/API sichtbar (i.d.R. "1-1")
modem_id = "1-1"

; -- method = "sms" --
; Kurzwahl, an die die Abfrage-SMS geschickt wird
query_number = "111"
; Text der Abfrage-SMS
query_text = "Guthaben"
; Erwarteter Absender der Antwort-SMS (Anbieter-spezifisch, hier Vodafone)
reply_sender = "80808"

; -- gemeinsam --
; Schwellenwerte in Euro: >= warn_threshold_eur = ok (Ticket wird
; geschlossen), zwischen alarm_threshold_eur und warn_threshold_eur = Ticket
; bleibt offen mit erhoehter Prioritaet, < alarm_threshold_eur = Ticket
; bleibt offen mit hoechster Prioritaet UND jede SMS-Versand-Notiz bekommt
; zusaetzlich einen Warnhinweis
warn_threshold_eur = 5.00
alarm_threshold_eur = 1.00
; Mindestabstand zwischen zwei Abfragen in Stunden -- gilt NUR fuer die
; SMS-Methode (kostet eine echte SMS). USSD ist synchron/kostenlos und
; wird NIE gegen dieses Zeitfenster geprueft, egal ob als method="ussd"
; oder als Fallback nach einem fehlgeschlagenen SMS-Versuch.
query_interval_hours = 24
; Zammad state_id fuer "closed" -- Standard-Zammad-Installationen nutzen 4,
; bei Abweichungen ueber 'GET /api/v1/ticket_states' pruefen
closed_state_id = 4
; Regex zum Erkennen des Guthaben-Betrags in der USSD- bzw. SMS-Antwort,
; GENAU EINE Erfassungsgruppe '(...)' fuer den Betrag (deutsches Komma als
; Dezimaltrenner, z.B. "25,77"). Gross-/Kleinschreibung wird ignoriert.
; Aendert der Provider den Antworttext (z.B. neue Werbeformulierung), reicht
; es, hier den Regex anzupassen -- kein Code-Deploy noetig. Defaults passen
; zum aktuellen Vodafone-Callya-Wortlaut.
; Der USSD-Default deckt bewusst BEIDE live beobachteten Wortlaute ab --
; "Kontostand: 12,26 EUR" (Kurzcode "*106#") und "Aktuelles Guthaben:
; 25,77 EUR" (Menue-Code "*100#") -- und verankert nur an
; "Guthaben"/"Kontostand", damit geaenderter Text davor nichts kaputt macht.
ussd_balance_regex = "(?:Guthaben|Kontostand):\s*(\d+(?:,\d+)?)\s*EUR"
sms_balance_regex = "Guthaben\s+betr[äa]gt\s+(\d+(?:,\d+)?)\s*Euro"

[ticket_to_sms]
; "multipart" (Default): der GESAMTE Text geht in EINEM Request an den
;             Router, der die echte SMS-Verkettung uebernimmt -- Empfaenger
;             sieht EINE Nachricht. Bis zur sicheren AWS/Twilio-Grenze fuer
;             Concatenated SMS (153 GSM-7-Septets/67 UCS-2-Codeeinheiten
;             pro Segment, siehe README).
; "classic"   -- eigenes Aufteilen in mehrere eigenstaendige Einzel-SMS mit
;             "(N/M) "-Praefix (bisheriges Verhalten), jede Nachricht ein
;             eigener API-Aufruf, kein Reassembly durch den Router.
send_mode = "multipart"
; Anzahl SMS-Sende-Einheiten ("Credits"), die eine Nachricht maximal
; kosten darf, bevor on_overflow greift. Im "classic"-Modus: Anzahl
; separater Einzel-SMS (kein Deckel -- jeder Wert wirkt).
; Im "multipart"-Modus: Anzahl echter Netz-Segmente, das ergibt ein
; Zeichen-Budget von max_sms_parts * 153 (GSM-7) bzw. max_sms_parts * 67
; (UCS-2) -- ABER gedeckelt durch die harte AWS/Twilio-Obergrenze von 1530
; GSM-7-/630 UCS-2-Zeichen (siehe README). Effektives MAXIMUM ist daher
; max_sms_parts = 10 -- ab da ist die harte Obergrenze in JEDEM Encoding
; bereits erreicht (10*153=1530, 10*67=670>630), hoehere Werte aendern im
; Multipart-Modus nichts mehr.
max_sms_parts = 3
; Verhalten bei Ueberlauf (> max_sms_parts):
; "reject"   -- gar nicht senden, Fehler-Notiz, Tag sms-overflow, Prioritaet
;               hoch (overflow_priority) -- Agent muss den Text kuerzen.
; "truncate" -- die ersten max_sms_parts Teile/Segmente trotzdem senden,
;               Notiz weist auf die Kuerzung hin und zeigt den tatsaechlich
;               gesendeten (gekuerzten) Text.
on_overflow = "reject"
; SMS-Sende-Budget (rollierende Fenster), gilt pro tatsaechlich versendeter
; SMS. Mehrteiler zaehlen mehrfach -- in BEIDEN Modi: im "classic"-Modus
; je separat versendeter Einzel-SMS, im "multipart"-Modus je tatsaechlich
; benoetigtem Netz-Segment (intern berechnet, siehe send_mode oben), auch
; wenn dabei nur EIN API-Aufruf stattfindet. Bei Ueberschreitung wird das
; jeweilige Ticket zurueckgestellt (Tag sms-out bleibt stehen) und im
; naechsten Lauf erneut versucht.
max_sms_per_hour = 20
max_sms_per_24h = 100
; SQLite-Datenbank fuer Budget-Zaehler UND Statistik (Zeitpunkt/Richtung/
; Gruppe/Agent je SMS) -- muss fuer den Cron-User beschreibbar sein. Wird
; sowohl fuer die Rate-Limit-Pruefung als auch fuer den 'stats'-Subcommand
; und die Gruppe/Agent-Aufschluesselung in der Budget-Warn-Mail benutzt.
stats_db_file = "~/.local/state/smsammad/stats.db"
; Mindestabstand zwischen zwei Budget-Ueberschreitungs-Mails, um bei mehreren
; Cronlaeufen in Folge nicht jedes Mal erneut zu mailen
budget_notify_cooldown_minutes = 60

[zammad]
; Basis-URL der Zammad-Instanz, ohne /api/v1
url = "https://zammad.example.local"
; Access Token eines API-Users mit Rechten fuer Ticket/Artikel/Tag/User-Objekte
token = "CHANGEME"
; Gruppe fuer neue Tickets von bereits bekannten Kunden OHNE offenes Ticket
; -- Default/Fallback, falls group_from_last_ticket unten deaktiviert ist
; oder der Kunde noch gar kein Ticket hatte. WICHTIG bei verschachtelten
; Zammad-Gruppen (Untergruppen): der EXAKTE, VOLLE Name mit "::"-Trenner
; wird gebraucht (z.B. "Elterngruppe::Kindgruppe"), nicht nur der
; sichtbare Kurzname -- live einen 422-Fehler "No lookup value found for
; 'group'" verursacht, weil der Kurzname allein nicht matcht. Echte Namen
; pruefen: 'GET /api/v1/groups' (oder [zammad] self_manage_setup=true +
; 'check-setup' Subcommand, siehe README, prueft das automatisch mit).
group = "Users"
; Gruppe fuer neue Tickets von SMS-Absendern ohne bestehenden Zammad-Kunden
; (eigene Triage-Queue zur manuellen Sichtung) -- gleicher Hinweis zu
; verschachtelten Gruppennamen wie bei `group` oben.
new_customer_group = "SMS-Eingang-Unbekannt"
; false (Default): neues Ticket eines bekannten Kunden ohne offenes Ticket
; landet immer in der festen Gruppe `group` oben.
; true: landet stattdessen in der Gruppe seines zuletzt kontaktierten
; Tickets (egal ob offen/geschlossen/zusammengefuehrt) -- sinnvoll fuer
; kundenzentrisch arbeitende Teams ("one face to the customer"), bei denen
; granulare Einordnung ueber Tags statt Queues laeuft. Fallback auf
; `group`, falls der Kunde noch gar kein Ticket hatte.
group_from_last_ticket = false
; Zammad-Nutzerfeld, das die Mobilnummer enthaelt
phone_field = "mobile"
; Fallback-Feld, falls phone_field beim Kunden leer ist -- wird nur
; genutzt, wenn der dortige Wert tatsaechlich als Mobilfunknummer erkannt
; wird (eine Festnetznummer kann keine SMS empfangen)
phone_field_fallback = "phone"
; Prioritaets-ID, die bei jedem Tag 'sms-cannotsend' gesetzt wird (nicht
; nur bei SMS-Ueberlauf, trotz des Namens)
overflow_priority = 3
; Zammad state_id fuer "offen" -- Standard-Zammad-Installationen nutzen 2,
; bei Abweichungen ueber 'GET /api/v1/ticket_states' pruefen. Wird gesetzt,
; wenn ein Ticket mit 'sms-cannotsend' markiert wird und aktuell nicht
; bereits offen ist (z.B. geschlossen oder "Warten auf Rueckmeldung")
open_state_id = 2
; Schalter fuer den Subcommand 'check-setup' (siehe README): prueft (und
; mit --fix repariert) den Trigger 'sms-out' und den eigenen Gruppen-
; zugriff auf group/new_customer_group oben. HART ABGESCHALTET per
; Default (false) -- dieses Feature braucht einen API-Token mit
; erweiterten Rechten (Trigger-Verwaltung, Nutzerverwaltung), die nicht
; jede Installation vergeben moechte. Kann jederzeit wieder auf false
; gesetzt werden, um das Feature komplett zu deaktivieren (z.B. falls
; sich Zammads Trigger-/Berechtigungs-API in einem Update aendert).
self_manage_setup = false

